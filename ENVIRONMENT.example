# متغيرات بيئة سوق أبدع — انسخ هذا المحتوى إلى ملف البيئة المحلي واملأ القيم.
# لا تضع قيماً حقيقية في المستودع ولا تشارك ملف البيئة المحلي.

# قاعدة البيانات والجلسات
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-session-secret

# Manus OAuth
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://oauth.manus.im
VITE_OAUTH_PORTAL_URL=https://auth.manus.im

# مالك المشروع وصلاحية المدير
OWNER_OPEN_ID=your-owner-open-id
OWNER_NAME=your-owner-name

# Manus Built-in APIs (الخادم)
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your-server-forge-api-key

# Manus Built-in APIs (الواجهة عند الحاجة)
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key

# اختياري: التحليلات
# VITE_ANALYTICS_ENDPOINT=https://analytics.example.com
# VITE_ANALYTICS_WEBSITE_ID=your-analytics-website-id
